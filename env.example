# Example environment variables. Copy values into your shell or hosting provider secrets.
# Do not commit a real .env file or real credentials.
SPRING_PROFILES_ACTIVE=dev
PORT=3000
INITIAL_ADMIN_EMAIL=officer@driems.ac.in
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password

# For MySQL deployment, set SPRING_PROFILES_ACTIVE=mysql and configure:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=placement_db
DB_USERNAME=placement_user
DB_PASSWORD=replace-with-a-strong-database-password
# Optional full JDBC URL overrides DB_HOST/PORT/NAME:
# DB_URL=jdbc:mysql://localhost:3306/placement_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
