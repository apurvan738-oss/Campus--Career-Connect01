{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Spring Boot: Run Application",
      "type": "shell",
      "command": "mvn spring-boot:run",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$maven"]
    },
    {
      "label": "Spring Boot: Clean Package",
      "type": "shell",
      "command": "mvn clean package",
      "group": "build",
      "problemMatcher": ["$maven"]
    },
    {
      "label": "Spring Boot: Run Tests",
      "type": "shell",
      "command": "mvn test",
      "group": "test",
      "problemMatcher": ["$maven"]
    }
  ]
}
